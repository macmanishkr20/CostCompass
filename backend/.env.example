# ── CostCompass backend configuration ──────────────────────────────
# Copy to .env and fill in. Everything has a safe local default, so the
# server runs with no configuration at all (heuristic classifier + local
# file persistence).

# LangGraph classify node. When the classifier is enabled and a provider is
# configured, fuzzy/free-text use cases are mapped to task types by the LLM;
# otherwise a deterministic keyword heuristic is used. Provider auto-selects:
# Azure OpenAI if its endpoint+key are set, else Anthropic, else heuristic.
# The LLM NEVER computes costs — code computes every dollar.
ENABLE_LLM_CLASSIFIER=true

# Azure OpenAI (preferred). AZURE_OPENAI_DEPLOYMENT is the *deployment* name you
# created in the Azure portal (e.g. for a gpt-4o-mini model), not the model id.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Anthropic (direct) — alternative provider, used only if Azure OpenAI is unset.
ANTHROPIC_API_KEY=
# Optional override (e.g. a gateway). Leave blank for api.anthropic.com.
ANTHROPIC_BASE_URL=
CLASSIFIER_MODEL=claude-3-5-haiku-latest

# Persistence. With no Cosmos config, estimations are stored as JSON
# files under DATA_DIR. Set the Cosmos vars (and `pip install azure-cosmos`)
# to use Azure Cosmos DB instead — same repository interface.
DATA_DIR=./.data
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=costcompass
COSMOS_CONTAINER=estimations

# Comma-separated CORS allow-list (the Angular dev server).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
